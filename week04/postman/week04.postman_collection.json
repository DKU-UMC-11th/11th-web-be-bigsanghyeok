                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/books",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"categoryId\": 999,\n  \"title\": \"제목\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "code": 404,
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "body": "{\n  \"type\": \"about:blank\",\n  \"title\": \"Not Found\",\n  \"status\": 404,\n  \"detail\": \"존재하지 않는 카테고리입니다.\",\n  \"instance\": \"/books\"\n}"
        }
      ],
      "event": [
        {
          "listen": "test",
          "script": {
