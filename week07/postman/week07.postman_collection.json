        "url": "{{baseUrl}}/members",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"a07@example.com\",\n  \"password\": \"Movie123!\",\n  \"nickname\": \"칠주차A\"\n}",
